{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qfoldit.github.io/contracts/qfoldit.scientific-adapter.schema.json",
  "title": "qFoldIT Scientific Adapter Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec", "adapter", "scientific_engine", "capabilities", "provenance_uri"],
  "properties": {
    "spec": { "const": "qfoldit.scientific-adapter/1.0" },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "domain"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 }
      }
    },
    "scientific_engine": { "type": "string", "minLength": 1 },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "domain", "description", "input_schemas", "output_schemas", "validator_requirements", "consequential"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "domain": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "input_schemas": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "output_schemas": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "validator_requirements": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "consequential": { "type": "boolean" }
        }
      }
    },
    "provenance_uri": { "type": "string", "minLength": 1 }
  }
}
